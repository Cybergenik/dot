#!/bin/bash

SAVE_PATH=$HOME/media/vids/

LAST_FILE=$SAVE_PATH.last
PID_FILE=$SAVE_PATH.pid
LOG_FILE=$SAVE_PATH.log

mkdir -p "$SAVE_PATH"

# copy stdin to the clipboard
clip() {
	if [ -n "$WAYLAND_DISPLAY" ]; then
		wl-copy
	else
		xclip -selection clipboard
	fi >/dev/null 2>&1
}

# print the region to record as "X Y W H"
select_region() {
	if [ -n "$WAYLAND_DISPLAY" ]; then
		slurp -f "%x %y %w %h"
	else
		slop -f "%x %y %w %h"
	fi
}

# pid of the running recorder, if any
recorder_pid() {
	local pid
	pid=$(cat "$PID_FILE" 2>/dev/null) || return
	case "$(cat "/proc/$pid/comm" 2>/dev/null)" in
		ffmpeg|wf-recorder) echo "$pid" ;;
	esac
}

ARGV=("$@")

while [ $# -gt 0 ]; do
	case "$1" in
		-n|--name) FILE="$SAVE_PATH$2.mp4"; shift ;;
	esac
	shift
done

[ -z "$FILE" ] && FILE=$(date +"${SAVE_PATH}%Y-%m-%d_%H-%M-%S.mp4")

set -- "${ARGV[@]}"

# Handle quick actions that don't touch the recorder
while [ $# -gt 0 ]; do
	case "$1" in
		-c|--copy)
			clip < "$LAST_FILE"
			exit 0 ;;
		-l|--last)
			cat "$LAST_FILE" && echo
			exit 0 ;;
		-v|--view)
			if [ -z "$2" ]; then
				mplayer "$(cat "$LAST_FILE")" &>/dev/null &
			else
				mplayer "$SAVE_PATH$2.mp4" &>/dev/null &
			fi
			exit 0 ;;
	esac
	shift
done

set -- "${ARGV[@]}"

PID=$(recorder_pid)

# Not recording yet: pick a region and start
if [ -z "$PID" ]; then
	REGION=$(select_region) || exit 1
	read -r X Y W H <<< "$REGION"

	# libx264 needs even dimensions
	rvid "$X" "$Y" $((W / 2 * 2)) $((H / 2 * 2)) "$FILE" > "$LOG_FILE" 2>&1 < /dev/null &
	echo $! > "$PID_FILE"

	# bail out if the recorder died on startup
	sleep 1
	if ! kill -0 $! 2>/dev/null; then
		rm -f "$PID_FILE"
		[ -s "$FILE" ] || rm -f "$FILE"
		echo "failed: $(tail -n 1 "$LOG_FILE")"
		exit 1
	fi

	echo -n "$FILE" > "$LAST_FILE"
	echo "recording!"
	exit 0
fi

# Stop recording and wait for the file to be finalized
kill -INT "$PID"
timeout 30 tail --pid="$PID" -f /dev/null
rm -f "$PID_FILE"

# Post-recording actions
while [ $# -gt 0 ]; do
	case "$1" in
		-r|--rename)
			result=$(mktemp)
			prevloc=$(mktemp)
			ROFI_SAVE_DIR="$SAVE_PATH" ROFI_SAVE_EXT=.mp4 ROFI_SAVE_RESULT="$result" ROFI_SAVE_PREVLOC="$prevloc" rofi -show save -modi "save:rofi-save" >/dev/null 2>&1
			new=$(cat "$result")
			rm -f "$result" "$prevloc"
			old=$(cat "$LAST_FILE")
			if [ -n "$new" ] && [ "$new" != "$old" ]; then
				if [ -e "$new" ]; then
					confirm=$(echo -e "Y\nn" | rofi -dmenu -p "overwrite $(basename "$new")? [Y/n]" 2>/dev/null)
					[ "$confirm" = "n" ] && new=""
				fi
				if [ -n "$new" ]; then
					mkdir -p "$(dirname "$new")"
					mv "$old" "$new"
					echo -n "$new" > "$LAST_FILE"
				fi
			fi
			clip < "$LAST_FILE"
			cat "$LAST_FILE" ;;
		-e|--echo)
			cat "$LAST_FILE" ;;
		-x|--xclip)
			clip < "$LAST_FILE" ;;
		-p|--play)
			mplayer "$(cat "$LAST_FILE")" &>/dev/null & ;;
	esac
	shift
done
